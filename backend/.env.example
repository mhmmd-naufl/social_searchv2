# Salin file ini menjadi backend/.env lalu isi nilai Anda sendiri.
# Jangan pernah commit file .env yang sudah berisi secret.

# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=new_tiktok_db
COLLECTION_NAME=videos

# Frontend yang diizinkan mengakses API (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGINS=http://localhost:5173

# OpenWeatherMap API key (dipakai backend, tidak pernah dikirim ke browser)
OPENWEATHER_API_KEY=isi_api_key_anda_di_sini
OPENWEATHER_CITY=Banyuwangi

# Cookie TikTok. Pilih salah satu:
# 1) TIKTOK_COOKIES_JSON dengan JSON array hasil export cookie, atau
# 2) simpan array tersebut ke backend/app/cookies.json (sudah di-gitignore).
TIKTOK_COOKIES_JSON=
TIKTOK_COOKIES_FILE=
